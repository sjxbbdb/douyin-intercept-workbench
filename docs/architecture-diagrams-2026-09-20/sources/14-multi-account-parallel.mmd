        QA --> EA --> LA --> BA
        EA <--> DA
    end

    subgraph B["抖音账号 B"]
        QB["账号 B 流程队列"]
        EB["独立执行器"]
        LB["页面锁与发送调度"]
        BB["独立浏览器环境"]
        DB["独立检查点与动作账本"]

        QB --> EB --> LB --> BB
        EB <--> DB
    end

    Router --> QA
    Router --> QB

    Budget["服务端统一积分与任务预算"] --> EA
    Budget --> EB

    EA --> View["统一状态面板"]
