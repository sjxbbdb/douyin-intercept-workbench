# ============================================================
# 安全红线：以下内容绝不可提交 / 分享
# ============================================================

# 浏览器登录态（专用 Chrome 配置目录，含 Cookie、Token、localStorage）
dy-main/
dy-*/
ChromeProfile*/
User Data/

# 二维码、验证码截图
qr*.png
qr*.jpg
captcha*.png

# Cookie / 凭据 / 令牌
cookies*.txt
*cookie*.json
*.token
.env
.env.*
secrets*.json
credentials*.json

# ============================================================
# 运行数据（本机产生的业务数据，分享前必须清空）
# ============================================================

# 采集与筛选结果
filtered_comments.json
pipeline_raw.json
pipeline_videos.json
pipeline_topics.json
videos.json

# 进度 / 状态
pipeline_progress.json
pipeline_pause.json
pipeline_cleaning_report.json
scan_progress.json
scan_request.json
pipeline_request.json
live_monitor_status.json

# 回复队列与历史（含被回复用户信息）
replies_queue.json
replied_history.json
video_comment_queue.json
video_comment_config.json

# 直播数据
live_state.json
live_dm_state.json
live_config.json

# 积分 / 授权运行态（含账号信息）
license_state.json
credit_ledger.json
*.local.json

# 统计与日志
logs/
*.log
statistics*.json

# ============================================================
# 依赖与构建产物（本项目零依赖，保留规则以防后续引入）
# ============================================================
node_modules/
dist/
build/
coverage/

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
